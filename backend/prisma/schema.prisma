generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model booking {
  id               Int                @id(map: "pk_booking") @default(autoincrement())
  name             String             @db.VarChar(255)
  time_start       DateTime           @db.Timestamptz(6)
  time_end         DateTime           @db.Timestamptz(6)
  group_id         Int
  description      String?
  user_id          Int
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  groups           groups             @relation(fields: [group_id], references: [id], onUpdate: NoAction, map: "fk_booking_group")
  users            users              @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_booking_user")
  booking_approve  booking_approve[]
  booking_resource booking_resource[]
}

model booking_approve {
  id         Int      @id(map: "pk_booking_approve") @default(autoincrement())
  is_aprove  Boolean?
  booking_id Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  booking    booking  @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_booking_approve_booking")
}

model booking_resource {
  id          Int      @id(map: "pk_booking_resource") @default(autoincrement())
  resource_id Int
  booking_id  Int
  booking     booking  @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_booking_booking_id")
  resource    resource @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_booking_resource_id")
}

model company {
  id            Int             @id(map: "pk_company") @default(autoincrement())
  name          String          @unique(map: "uq_company_name") @db.VarChar(255)
  inn_number    String          @unique(map: "uq_company_inn") @db.VarChar(12)
  city          String?         @db.VarChar(100)
  timezone      String          @db.VarChar(50)
  description   String?
  search        Boolean?
  company_owner company_owner[]
  users         users[]
}

model company_owner {
  id         Int     @id(map: "pk_company_owner") @default(autoincrement())
  company_id Int
  user_id    Int
  company    company @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_company_owner_company")
  users      users   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_company_owner_user")

  @@unique([company_id, user_id], map: "uq_company_owner")
}

model groups {
  id             Int              @id(map: "pk_group") @default(autoincrement())
  name           String           @db.VarChar(50)
  booking        booking[]
  resource_group resource_group[]
}

model resource {
  id               Int                @id(map: "pk_resource") @default(autoincrement())
  name             String             @db.VarChar(100)
  location         String?            @db.VarChar(255)
  description      String?
  characteristic   String?
  resource_type_id Int?
  booking_resource booking_resource[]
  resource_type    resource_type?     @relation(fields: [resource_type_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_resource_type")
  resource_group   resource_group[]
  resource_owner   resource_owner[]
}

model resource_group {
  id          Int      @id(map: "pk_resource_group") @default(autoincrement())
  group_id    Int
  resource_id Int
  groups      groups   @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_res_group_group")
  resource    resource @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_res_group_resource")

  @@unique([group_id, resource_id], map: "uq_resource_group")
}

model resource_owner {
  id          Int      @id(map: "pk_resource_owner") @default(autoincrement())
  resource_id Int
  user_id     Int
  resource    resource @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_res_owner_resource")
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_res_owner_user")
}

model resource_type {
  id       Int        @id(map: "pk_resource_type") @default(autoincrement())
  name     String     @unique(map: "uq_resource_type_name") @db.VarChar(100)
  resource resource[]
}

model role {
  id    Int     @id(map: "pk_role") @default(autoincrement())
  name  String  @db.VarChar(50)
  users users[]
}

model users {
  id             Int              @id(map: "pk_user") @default(autoincrement())
  email          String           @unique(map: "uq_user_email") @db.VarChar(255)
  password_hash  String           @db.VarChar(255)
  first_name     String?          @db.VarChar(255)
  last_name      String?          @db.VarChar(255)
  role_id        Int
  company_id     Int
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  booking        booking[]
  company_owner  company_owner[]
  resource_owner resource_owner[]
  company        company          @relation(fields: [company_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_user_company")
  role           role             @relation(fields: [role_id], references: [id], onUpdate: NoAction, map: "fk_user_role")
}
